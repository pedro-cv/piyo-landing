---
// Shared shell for the policy pages Google Play links to (privacidad, borrar-datos, terminos).
// Plain prose, no motion: these pages must stay readable and stable at a fixed URL.
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string; // human date shown on the page, e.g. "11 de noviembre de 2026"
}
const { title, description, heading, updated } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pages = [
  { href: `${base}privacidad`, label: 'Privacidad' },
  { href: `${base}borrar-datos`, label: 'Borrar tus datos' },
  { href: `${base}terminos`, label: 'Términos' },
];
const here = Astro.url.pathname.replace(/\/$/, '');
---

<Base title={title} description={description} skipTo="#legal">
  <Header />
  <main class="page wrap" id="top">
    <p class="label"><a href={base}>piyo</a> · Legal</p>
    <h1 class="display heading">{heading}</h1>
    <p class="muted updated">Última actualización: {updated}</p>
    <nav class="legal-nav" aria-label="Páginas legales">
      {pages.map((p) => (
        <a href={p.href} aria-current={p.href.replace(/\/$/, '') === here ? 'page' : undefined}>{p.label}</a>
      ))}
    </nav>
    <article class="prose" id="legal">
      <slot />
    </article>
  </main>
  <Footer />
</Base>

<style>
  .page {
    padding-top: clamp(96px, 12vw, 160px);
    padding-bottom: var(--section);
  }
  .heading {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    margin-top: 16px;
  }
  .updated {
    margin-top: 16px;
  }
  .legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .legal-nav a {
    border-bottom: 1px solid var(--line-soft);
  }
  .legal-nav a[aria-current='page'] {
    border-bottom-color: var(--fg);
  }
  .prose {
    max-width: 68ch;
    margin-top: clamp(32px, 5vw, 56px);
    font-size: clamp(0.875rem, 0.82rem + 0.2vw, 1rem);
    line-height: 1.6;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: var(--fs-h3);
    line-height: 1;
    margin: 2.2em 0 0.6em;
  }
  .prose :global(h3) {
    font-size: 1em;
    font-weight: 700;
    margin: 1.6em 0 0.4em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(.table) {
    margin-bottom: 1em;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.25em;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.25em;
  }
  .prose :global(li + li) {
    margin-top: 0.35em;
  }
  .prose :global(a) {
    border-bottom: 1px solid var(--line);
  }
  .prose :global(.table) {
    overflow-x: auto;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.55em 0.75em 0.55em 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .prose :global(th) {
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 400;
  }
  .prose :global(.note) {
    border-left: 2px solid var(--accent);
    padding-left: 1em;
  }
</style>
