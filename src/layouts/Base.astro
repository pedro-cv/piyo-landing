---
import '@fontsource/anton';
import '@fontsource-variable/kode-mono';
import '@/styles/global.css';
import site from '@/data/site.json';

interface Props {
  title?: string;
  description?: string;
  preloadHero?: boolean;
  skipTo?: string; // target of the "Saltar al contenido" link
  jsonLd?: Record<string, unknown>[]; // extra schema.org nodes for this page, merged into one @graph
}
const { title = site.seo.title, description = site.description, preloadHero = false, skipTo = '#que-es', jsonLd = [] } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
// Absolute URLs (og:image, canonical, JSON-LD) are only emitted when PUBLIC_SITE is set at build time.
const origin = Astro.site?.toString();
const hasSite = !!origin && !origin.includes('piyo.example');
const og = hasSite ? new URL(`${base}og.jpg`, origin).toString() : null;
// One URL per page: no trailing slash (vercel.json redirects /x/ to /x), root stays "/".
const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = hasSite ? new URL(path, origin).toString() : null;
const home = hasSite ? new URL(base, origin).toString() : null;
const graph = home
  ? [
      {
        '@type': 'WebSite',
        '@id': `${home}#website`,
        url: home,
        name: site.name,
        description: site.description,
        inLanguage: 'es-BO',
        publisher: { '@id': `${home}#org` },
      },
      {
        '@type': 'Organization',
        '@id': `${home}#org`,
        name: site.name,
        url: home,
        logo: new URL(`${base}icon-512.png`, origin).toString(),
        email: site.contact.email,
        sameAs: [site.repos.app.url, site.repos.backend.url],
      },
      ...jsonLd,
    ]
  : [];
---

<!doctype html>
<html lang="es-BO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#2a6a47" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${base}favicon-48.png`} sizes="48x48" type="image/png" />
    <link rel="icon" href={`${base}icon-192.png`} sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {og && <meta property="og:image" content={og} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    {og && <meta property="og:image:alt" content={site.seo.ogAlt} />}
    <meta property="og:locale" content="es_BO" />
    <meta name="twitter:card" content={og ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />}
    {preloadHero && (
      <>
        <link rel="preload" as="image" type="image/webp" media="(orientation: portrait)" imagesrcset={`${base}hero-portrait-720.webp 720w, ${base}hero-portrait-1080.webp 1080w`} imagesizes="max(100vw, 56.25vh)" fetchpriority="high" />
        <link rel="preload" as="image" type="image/webp" media="(orientation: landscape)" imagesrcset={`${base}hero-1280.webp 1280w, ${base}hero-2048.webp 2048w`} imagesizes="max(100vw, 177.78vh)" fetchpriority="high" />
      </>
    )}
  </head>
  <body>
    <a class="skip" href={skipTo}>Saltar al contenido</a>
    <slot />
    <script>
      import { initMotion } from '@/scripts/motion';
      initMotion();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    z-index: 100;
    padding: 0.5em 0.75em;
    background: var(--green-900);
    color: var(--paper);
    font-size: var(--fs-label);
  }
  .skip:focus {
    top: 8px;
  }
</style>
