---
// Section transition: a grid of cells dissolves from one colour to the next as you scroll.
// Drawn on one small canvas with a single scroll-driven progress value (no per-cell tweens).
interface Props {
  from: string;
  to: string;
  cols?: number;
  rows?: number;
  accents?: string;
}
const { from, to, cols = 25, rows = 6, accents = 'var(--terracotta),var(--green-300)' } = Astro.props;
---

<canvas class="pixel-grid" data-pixel-grid data-from={from} data-to={to} data-cols={cols} data-rows={rows} data-accents={accents} aria-hidden="true"></canvas>

<style>
  .pixel-grid {
    display: block;
    width: 100%;
    height: clamp(72px, 10vw, 160px);
    pointer-events: none;
  }
</style>

<script>
  import { ScrollTrigger, reduced } from '@/scripts/motion';

  const css = getComputedStyle(document.documentElement);
  const resolve = (v: string) => {
    const m = v.trim().match(/^var\((--[\w-]+)\)$/);
    return m ? css.getPropertyValue(m[1]).trim() : v.trim();
  };
  const mulberry = (seed: number) => () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  document.querySelectorAll<HTMLCanvasElement>('[data-pixel-grid]').forEach((canvas, gi) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const cols = Number(canvas.dataset.cols);
    const rows = Number(canvas.dataset.rows);
    const from = resolve(canvas.dataset.from!);
    const to = resolve(canvas.dataset.to!);
    const accents = (canvas.dataset.accents ?? '').split(',').filter(Boolean).map(resolve);
    const rnd = mulberry(1234 + gi * 97);
    // each cell: its switch time (0..1) and an optional accent colour shown briefly before settling
    const cells = Array.from({ length: cols * rows }, () => ({ t: rnd(), accent: rnd() < 0.03 ? accents[Math.floor(rnd() * accents.length)] : null }));
    let p = reduced ? 1 : 0;
    let w = 0;
    let h = 0;

    const draw = () => {
      const cw = w / cols;
      const ch = h / rows;
      ctx.fillStyle = from;
      ctx.fillRect(0, 0, w, h);
      for (let i = 0; i < cells.length; i++) {
        const c = cells[i];
        if (p < c.t) continue;
        const x = (i % cols) * cw;
        const y = Math.floor(i / cols) * ch;
        ctx.fillStyle = c.accent && p < c.t + 0.12 ? c.accent : to;
        ctx.fillRect(Math.floor(x), Math.floor(y), Math.ceil(cw) + 1, Math.ceil(ch) + 1);
      }
    };
    const size = () => {
      const r = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(r.width / 2)); // half resolution: cells are big, nobody sees the difference
      h = Math.max(1, Math.round(r.height / 2));
      canvas.width = w;
      canvas.height = h;
      draw();
    };
    new ResizeObserver(size).observe(canvas);
    if (!reduced) {
      ScrollTrigger.create({
        trigger: canvas,
        start: 'top 92%',
        end: 'bottom 35%',
        onUpdate: (self) => {
          const np = Math.round(self.progress * 100) / 100;
          if (np !== p) {
            p = np;
            draw();
          }
        },
      });
    }
  });
</script>
